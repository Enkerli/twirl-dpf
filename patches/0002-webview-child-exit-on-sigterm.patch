@@ -2618,9 +2618,12 @@ static void signalHandler(const int sig)
     switch (sig)
     {
     case SIGTERM:
-        if (webFramework != nullptr)
-            webFramework->terminate();
-        break;
+        // The host is closing the view. Calling into Qt or GTK from a signal
