+// Keyboard focus, on the child's side. The web view is a window of this process
+// inside the plugin's window; X gives keys to the focused window, which stays
+// the host's after a click on the web view, so the page never got them. The
+// page says when it's pressed ("__dpf_focus", from the initial JS) and the
+// web view takes the focus: allowed, being inside the host's focused window.
+static ::Display* s_focusDisplay = nullptr;
+static ::Window s_focusParent = 0;
+static ::Window s_focusWindow = 0; // the web view's own window, where known (Qt): it may be moved to another parent
+
+static bool webview_focus_message(const char* const msg)
+{
+    if (std::strcmp(msg, "__dpf_focus") != 0)
+        return false;
+
+    if (s_focusDisplay != nullptr && s_focusWindow != 0)
+    {
+        XSetInputFocus(s_focusDisplay, s_focusWindow, RevertToParent, CurrentTime);
+        XFlush(s_focusDisplay);
+        return true;
+    }
+
+    ::Window root = 0, parent = 0, *children = nullptr;
+    uint count = 0;
+    if (s_focusDisplay != nullptr && s_focusParent != 0 &&
+        XQueryTree(s_focusDisplay, s_focusParent, &root, &parent, &children, &count) != 0)
+    {
+        if (count != 0)
+            XSetInputFocus(s_focusDisplay, children[count - 1], RevertToParent, CurrentTime);
+        if (children != nullptr)
+            XFree(children);
+        XFlush(s_focusDisplay);
+    }
+    return true;
+}
+
