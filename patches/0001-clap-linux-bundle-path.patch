 {
     static String bundlePath;
     bundlePath = plugin_path;
+   #ifndef DISTRHO_OS_MAC
+    // Outside macOS a .clap is a file, which DPF installs inside a folder of the
+    // same name with resources/ beside it (X.clap/X.clap, X.clap/resources).
+    // Hosts such as Bitwig pass the file's path: use its folder as the bundle.
+    {
+        struct stat st;
